/** app.wxss - 极简黑曜石与古希腊剧场沉浸风 **/
page {
  background-color: #05070d;
  color: #e2e8f0;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.7;
  box-sizing: border-box;
  --color-bg-deep: #05070d;
  --color-bg-card: #0c101c;
  --color-bg-card-glass: rgba(12, 16, 28, 0.95);
  --color-gold-primary: #d4af37;
  --color-gold-light: #f3e5ab;
  --color-gold-dark: #7a631c;
  --color-text-main: #f8fafc;
  --color-text-sub: #8492a6;
  --color-accent-blue: #38bdf8;
  --color-accent-red: #f43f5e;
  --color-accent-green: #10b981;
  --color-border-gold: rgba(212, 175, 55, 0.45);
  --color-border-subtle: rgba(255, 255, 255, 0.08);
}

/* 按钮全局直角硬朗化 */
button {
  border-radius: 0 !important;
  font-weight: 500;
  transition: all 0.2s ease;
}

button::after {
  border: none;
}

/* 希腊金黑曜石主按钮 */
.btn-gold {
  background: #0d121f;
  color: var(--color-gold-light);
  border: 1px solid var(--color-gold-primary);
  border-left: 4px solid var(--color-gold-primary);
  box-shadow: 0 0 20rpx rgba(212, 175, 55, 0.15);
  font-weight: bold;
}

.btn-gold:active {
  background: rgba(212, 175, 55, 0.2);
  color: #fff;
}

/* 暗色次要按钮 */
.btn-secondary {
  background: #080b13;
  color: #cbd5e1;
  border: 1px solid var(--color-border-subtle);
  border-left: 2px solid rgba(255, 255, 255, 0.2);
}

.btn-secondary:active {
  background: #141b2b;
  border-color: rgba(212, 175, 55, 0.3);
}

/* 剧场式黑曜石卡片：直角、上下单线金色隔断 */
.stone-card {
  background: var(--color-bg-card-glass);
  border-radius: 0 !important;
  border-top: 1px solid var(--color-border-gold);
  border-bottom: 1px solid var(--color-border-gold);
  border-left: 1px solid var(--color-border-subtle);
  border-right: 1px solid var(--color-border-subtle);
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.7);
}

/* 动画定义 */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(8rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.animate-fade-in {
  animation: fadeIn 0.35s ease-out forwards;
}
